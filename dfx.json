{
  "canisters": {
    "karciane_backend": {
      "main": "src/karciane_backend/main.mo",
      "type": "motoko"
    },
    "karciane_frontend": {
      "dependencies": ["karciane_backend"],
      "frontend": {
        "entrypoint": "src/karciane_frontend/dist/index.html"
      },
      "source": ["src/karciane_frontend/dist"],
      "type": "assets",
      "workspace": "karciane_frontend",
      "build": [
        "cd src/karciane_frontend",
        "npm ci",
        "npm run build"
      ]
    }
  },
  "defaults": {
    "build": {
      "args": "",
      "packtool": ""
    }
  },
  "output_env_file": ".env",
  "version": 1
}